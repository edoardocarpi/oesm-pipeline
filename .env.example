# Copia questo file in .env e compila i valori reali.
# .env NON va mai committato (vedi .gitignore).

# Project Settings -> API -> Project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Project Settings -> API -> service_role secret
# ATTENZIONE: questa chiave bypassa tutte le policy RLS. Solo lato server/pipeline,
# mai in un frontend, mai in un repository pubblico.
SUPABASE_SERVICE_ROLE_KEY=

# Opzionale: per gli avvisi dei watcher (nuovi bollettini statistica.sm / BCSM)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
